# Template for an Explorer config bundle. See ../README.md.
#
# How to use:
#   1. cp _template.env /tmp/<name>.env
#   2. fill in the values you want shipped to every <name> host
#   3. openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt \
#        -in /tmp/<name>.env -out <name>.env.enc -pass stdin
#   4. shred -u /tmp/<name>.env      ← never leave plaintext behind
#   5. store <name>.env.enc PRIVATELY — do not commit it to this repository
#
# DO NOT include here (per-host, handled by bootstrap.sh):
#   • EXPLORER_SESSION_SECRET  (must be unique per host)
#   • AUTH_SIGNING_PUBKEY      (a public key; needs no encryption)

# ── AWS / S3 (use a read-only key scoped to one prefix) ─────────────────
# Leave both key values empty to use an instance role instead.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

EMAIL_S3_BUCKET=""
EMAIL_S3_PREFIX="emails/"
EMAIL_S3_DATE_PREFIX_FORMAT="emails/%Y/%m/%d/"
EMAIL_S3_MAX_DATE_PREFIX_DAYS="62"
EMAIL_HEADER_FETCH_BYTES="65536"

# ── Auth service location (the public key stays per-host) ──────────────
AUTH_LOGIN_URL="https://auth.example.com"
