# Explorer configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env (and .env.shared, and every other .env.* file) is gitignored.
# NEVER commit real credentials. See docs/DEPLOYMENT.md for the full
# reference and the minimum AWS IAM policy.

# ── AWS credentials for reading the email archive ───────────────────────
# Scope these to read-only on ONE bucket prefix (s3:ListBucket +
# s3:GetObject). Leave blank to fall back to the ambient AWS credential
# chain (instance role, ~/.aws/credentials, AWS_PROFILE, ...).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Region the archive bucket lives in.
AWS_REGION="us-east-1"

# ── Where the SES-delivered messages live ───────────────────────────────
# Bucket holding the raw MIME objects written by the SES S3 action.
EMAIL_S3_BUCKET="my-email-archive"
# Key prefix everything lives under. Doubles as a safety boundary: the app
# refuses to read any S3 key outside it.
EMAIL_S3_PREFIX="emails/"
# strftime pattern for one day's partition. Must produce a key prefix, so
# it normally starts with EMAIL_S3_PREFIX and ends with "/". Set to an
# empty string if your archive is NOT date-partitioned (slower: every
# search then lists the whole prefix).
EMAIL_S3_DATE_PREFIX_FORMAT="emails/%Y/%m/%d/"
# Largest span, in days, that still gets the per-day prefix treatment.
# Wider spans fall back to listing EMAIL_S3_PREFIX wholesale.
EMAIL_S3_MAX_DATE_PREFIX_DAYS="62"

# ── Search tuning (optional; defaults shown) ────────────────────────────
# Bytes fetched from the head of each object to parse headers, via an S3
# ranged GET. Big enough for the header block, small enough to stay cheap.
EMAIL_HEADER_FETCH_BYTES="65536"
# Cap on the window a body-inclusive fuzzy search will scan (bodies mean
# a full object download per message).
EMAIL_S3_MAX_BODY_SEARCH_DAYS="14"
# Server-side cancellation for a runaway search job, in seconds.
EMAIL_SEARCH_JOB_MAX_SECONDS="120"

# ── Authentication ──────────────────────────────────────────────────────
# Base64 Ed25519 PUBLIC key of the magic-link auth service that mints the
# session cookie. REQUIRED: with it unset every request redirects to the
# login URL, which looks like an infinite redirect loop. A public key can
# only verify, never mint, so it is safe to store here.
AUTH_SIGNING_PUBKEY=""
# Where unauthenticated browsers are sent to sign in.
AUTH_LOGIN_URL="https://auth.example.com"
# Name of the session cookie minted by that service.
AUTH_COOKIE_NAME="elcano_auth"

# ── Local session cookie ────────────────────────────────────────────────
# Signs the short-lived cookie that scopes search jobs to one browser.
# NOT the auth boundary, but still generate a real value:
#   openssl rand -hex 32
EXPLORER_SESSION_SECRET=""
