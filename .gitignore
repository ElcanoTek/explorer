# Build output
/explorer
/dist/
*.test
*.out
coverage.*

# Local configuration — NEVER commit a dotenv file; only .env.example is
# tracked. A real one has been committed here before.
.env
.env.*
!.env.example
.envrc

# Encrypted provisioning bundles live in private infrastructure, never here
# (provision/README.md).
provision/clients/*.env.enc
provision/clients/*.env
!provision/clients/_template.env

# Editors and OS noise
.idea/
.vscode/
*.swp
.DS_Store

