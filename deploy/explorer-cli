# /usr/local/bin/explorer — operator entry point for the Elcano
# Explorer email-archive service.
#
# Thin dispatcher that forwards to systemctl/journalctl and to
# scripts/update.sh for in-place updates. Installed by
# scripts/bootstrap.sh. Patterned after gig/moc.

set -euo pipefail

SRC_DIR="${EXPLORER_SRC_DIR:-/opt/explorer-src}"
APP_DIR="${EXPLORER_APP_DIR:-/opt/explorer}"
ENV_FILE="$APP_DIR/.env"
SERVICE="explorer.service"

# update/provision are root operations. Refuse the hand-off unless the script
# tree is already exclusively root-controlled; checking after sudo would be
# too late because bash would already have opened the requested script.
require_trusted_checkout() {
  local dir=$1 path owner mode stray
  [[ -d $dir && ! -L $dir ]] || return 1
  path=$(readlink -f -- "$dir") || return 1
  while :; do
    owner=$(stat -c %U "$path") || return 1
    mode=$(stat -c %a "$path") || return 1
    [[ $owner == root ]] || return 1
    (( (8#$mode & 8#022) == 0 )) || return 1
    [[ $path == / ]] && break
    path=$(dirname -- "$path")
  done
  stray=$(find "$(readlink -f -- "$dir")" \
    \( ! -user root -o -perm -g+w -o -perm -o+w -o -type l \) \
    -print -quit 2>/dev/null)
  [[ -z $stray ]]
}
trusted_source_or_die() {
  require_trusted_checkout "$SRC_DIR" || {
    echo "$SRC_DIR is not an exclusively root-owned, non-writable, symlink-free checkout" >&2
    exit 1
  }
}

cmd="${1:-}"
shift || true

case "$cmd" in
  start)    exec sudo systemctl start "$SERVICE" ;;
  stop)     exec sudo systemctl stop "$SERVICE" ;;
  restart)  exec sudo systemctl restart "$SERVICE" ;;
  status)   exec sudo systemctl status "$SERVICE" ;;
  logs)
    if [[ $# -gt 0 ]]; then exec sudo journalctl -u "$SERVICE" "$@"; fi
    exec sudo journalctl -fu "$SERVICE"
    ;;
  update)
    [[ -d "$SRC_DIR/.git" ]] || { echo "no source checkout at $SRC_DIR" >&2; exit 1; }
    trusted_source_or_die
    exec sudo bash "$SRC_DIR/scripts/update.sh" "$@"
    ;;
  rebuild)
    # Rebuild and restart whatever is currently checked out, without
    # fetching or fast-forwarding the branch.  Useful after a manual
    # rollback or when you know the checkout is already correct.
    [[ -d "$SRC_DIR/.git" ]] || { echo "no source checkout at $SRC_DIR" >&2; exit 1; }
    trusted_source_or_die
    exec sudo env EXPLORER_UPDATE_NO_PULL=1 EXPLORER_UPDATE_YES=1 bash "$SRC_DIR/scripts/update.sh"
    ;;
  doctor)
    # Read-only diagnostics; never touches the install. Runs from the
    # source checkout so fixes to doctor.py apply on the next update.
    [[ -d "$SRC_DIR/.git" ]] || { echo "no source checkout at $SRC_DIR" >&2; exit 1; }
    exec sudo bash "$SRC_DIR/scripts/doctor.sh" "$@"
    ;;
  access)
    [[ -x "$APP_DIR/.venv/bin/python" ]] || { echo "Explorer venv missing at $APP_DIR/.venv" >&2; exit 1; }
    cd "$APP_DIR"
    exec sudo -u explorer "$APP_DIR/.venv/bin/python" -m app.access_admin access "$@"
    ;;
  provision)
    # Decrypt an optional encrypted config bundle and merge it into
    # /opt/explorer/.env. Pass --client=NAME to select a bundle and
    # --no-restart to skip the systemctl restart. See provision/README.md.
    [[ -d "$SRC_DIR/.git" ]] || { echo "no source checkout at $SRC_DIR" >&2; exit 1; }
    trusted_source_or_die
    exec sudo bash "$SRC_DIR/scripts/provision.sh" "$@"
    ;;
  env)
    sub="${1:-show}"; shift || true
    case "$sub" in
      show|print|"")
        [[ -f "$ENV_FILE" ]] || { echo "$ENV_FILE missing — run bootstrap.sh" >&2; exit 1; }
        awk -F= '
          /^[[:space:]]*#/    { next }
          /TOKEN|KEY|SECRET|PASSWORD/ { printf "%s=[REDACTED]\n", $1; next }
          NF>=2                { print }
        ' "$ENV_FILE"
        ;;
      edit)
        if sudo test -e "$ENV_FILE" || sudo test -L "$ENV_FILE"; then
          if ! sudo test -f "$ENV_FILE" || sudo test -L "$ENV_FILE" \
            || [[ $(sudo stat -c %h "$ENV_FILE") -ne 1 ]]; then
            echo "$ENV_FILE must be a single-link regular file" >&2
            exit 1
          fi
        else
          sudo install -o explorer -g explorer -m 0600 /dev/null "$ENV_FILE"
        fi
        editor="${EDITOR:-${VISUAL:-vi}}"
        exec sudo "$editor" "$ENV_FILE"
        ;;
      help|--help|-h|*)
        cat <<EOF
explorer env              print /opt/explorer/.env (secrets redacted)
explorer env edit         edit /opt/explorer/.env
EOF
        ;;
    esac
    ;;
  tls)
    sub="${1:-status}"; shift || true
    snippet=""
    marker="# Caddy site block for Explorer, imported by /etc/caddy/Caddyfile via"
    for candidate in /etc/caddy/Caddyfile.d/explorer.caddyfile /etc/caddy/conf.d/explorer.caddy; do
      if [[ -f $candidate ]] && IFS= read -r first < "$candidate" && [[ $first == "$marker" ]]; then
        snippet=$candidate
        break
      fi
    done
    if ! command -v caddy >/dev/null 2>&1; then
      echo "Caddy not installed — re-run bootstrap with a hostname to set up TLS" >&2; exit 1
    fi
    case "$sub" in
      status)
        if [[ -n $snippet ]]; then
          host=$(awk '/^[^[:space:]{}#]/ && /{/ {sub(" {",""); print; exit}' "$snippet" 2>/dev/null)
          echo "Host: ${host:-<unconfigured>}"
          if [[ -n "$host" ]]; then
            echo | openssl s_client -servername "$host" -connect "${host}:443" 2>/dev/null \
              | openssl x509 -noout -subject -issuer -dates 2>/dev/null \
              || echo "(could not reach ${host}:443 — check DNS + firewall)"
          fi
        else
          echo "No marker-owned Explorer Caddy site block found"
        fi
        sudo systemctl is-active caddy.service 2>&1 || true
        ;;
      reload)   exec sudo caddy reload --config /etc/caddy/Caddyfile ;;
      restart)  exec sudo systemctl restart caddy.service ;;
      help|--help|-h|*)
        cat <<EOF
explorer tls status     show hostname + cert expiry + Caddy state
explorer tls reload     reload /etc/caddy/Caddyfile without dropping connections
explorer tls restart    restart the Caddy service
EOF
        ;;
    esac
    ;;
  help|-h|--help|"")
    cat <<'EOF'
explorer — email-archive service operator CLI

SERVICE CONTROL
  explorer start | stop | restart | status
  explorer logs [journalctl args...]

UPDATES
  explorer update                   git pull + rebuild + restart
                                    (use EXPLORER_UPDATE_YES=1 to skip prompt)
  explorer rebuild                  rebuild + restart current checkout
                                    (skip fetch — useful after a manual rollback)
  explorer doctor [--json] [--strict]  read-only diagnostics: configuration,
                                    service, readiness, TLS, disk, packages

  explorer provision [--client=N]   decrypt an encrypted config bundle and
                                    merge into .env + restart
                                    (--no-restart to skip; see provision/README.md)

TLS (when Caddy was installed by bootstrap)
  explorer tls status               show hostname + cert expiry + Caddy state
  explorer tls reload               reload /etc/caddy/Caddyfile
  explorer tls restart              restart Caddy

CONFIG
  explorer env                      print /opt/explorer/.env (secrets redacted)
  explorer env edit                 edit /opt/explorer/.env

CENTRAL-AUTH ACCESS (EXPLORER_AUTH_MODE=central)
  explorer access grant EMAIL       allow a central account to use Explorer
  explorer access list [--all]      list allowed (or all known) emails
  explorer access revoke EMAIL      deny access and revoke Explorer sessions
EOF
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exec "$0" --help
    ;;
esac
